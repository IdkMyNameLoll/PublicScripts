NewGubby.Unequipped:Connect(function()
	NewGubby:WaitForChild("Handle").sound_equip2:Stop()
	for _, d in pairs(NewGubby:WaitForChild("Handle"):GetChildren()) do
		if d.Name == "clickclone" then
			d:Destroy()
		end
	end
end)
NewGubby.Activated:Connect(function()
	gubbyfy(game.Players.LocalPlayer:GetMouse().Target)
	local NewSound = NewGubby:WaitForChild("Handle"):WaitForChild("sound_click"):Clone()
	NewSound.Name = "clickclone"
	NewSound.Parent = NewGubby:WaitForChild("Handle")
	NewSound:Play()
	game.Debris:AddItem(NewSound,1)
end)
