local NewGubby:Tool = game:GetObjects(getcustomasset("IndexellScripts/ISTHATAGUBBY/Tool.rbxm", true))[1]
local GubbyfiedTemplate = NewGubby:Clone()
local tt = GubbyfiedTemplate

GubbyfiedTemplate = GubbyfiedTemplate.Model.Head
GubbyfiedTemplate.Parent = game.ReplicatedStorage
tt:Destroy()
GubbyfiedTemplate.Parent = nil

NewGubby:WaitForChild("Handle"):WaitForChild("sound_equip2").SoundId = getcustomasset("IndexellScripts/ISTHATAGUBBY/Equip.mp3", true)
NewGubby:WaitForChild("Handle"):WaitForChild("sound_click").SoundId = getcustomasset("IndexellScripts/ISTHATAGUBBY/Interact.mp3", true)
NewGubby.CanBeDropped = false

NewGubby.Parent = game.Players.LocalPlayer.Backpack

local function gubbythisgubbythat(part)
	local oldt = part.Transparency
	part.Transparency = 1
	local GubbyNew = GubbyfiedTemplate:Clone()
	GubbyNew.Name = "Part"
	GubbyNew.Size = part.Size
	GubbyNew.Mesh.Scale = part.Size
	GubbyNew.Transparency = oldt
	GubbyNew.Decal.Transparency = oldt
	local nweweld = Instance.new("Weld",GubbyNew)
	nweweld.Part0 = GubbyNew
	nweweld.Part1 = part
	GubbyNew.Parent = part
end

local function gubbyfy(p)
	if p == nil then return end
	local ToGubbyfy = p:FindFirstAncestorOfClass("Model") or p
	local GubbyfySelf = ToGubbyfy:IsA("BasePart")

	if workspace:FindFirstChild("CurrentRooms") then
		if ToGubbyfy.Parent == workspace.CurrentRooms then
			return
		end
	end

	if GubbyfySelf then
		gubbythisgubbythat(p)
	end

	for _, d in pairs(ToGubbyfy:GetDescendants()) do
		if d == p then continue end
		if d:IsA("BasePart") then
			gubbythisgubbythat(d)
		elseif d:IsA("Texture") or d:IsA("Decal") then
			d.Transparency = 1
		elseif d:IsA("Sound") then
			d:ClearAllChildren()
			d.SoundId = "rbxassetid://9118862378"
			if d.Volume < 3 then
				d.Volume = 3
			end
		end
	end
end

NewGubby.Equipped:Connect(function()
	NewGubby:WaitForChild("Handle").sound_equip2:Play()
end)
NewGubby.Unequipped:Connect(function()
	NewGubby:WaitForChild("Handle").sound_equip2:Stop()
	for _, d in pairs(NewGubby:WaitForChild("Handle"):GetChildren()) do
		if d.Name == "clickclone" then
			d:Destroy()
		end
	end
end)
NewGubby.Activated:Connect(function()
	gubbyfy(game.Players.LocalPlayer:GetMouse().Target)
	local NewSound = NewGubby:WaitForChild("Handle"):WaitForChild("sound_click"):Clone()
	NewSound.Name = "clickclone"
	NewSound.Parent = NewGubby:WaitForChild("Handle")
	NewSound:Play()
	game.Debris:AddItem(NewSound,1)
end)
