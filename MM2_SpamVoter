local MapName = _G.MapName or ""
local VoteTimes = _G.VoteTimes or 5

local Settings = {
	ReturnBackToOldPos = _G.GoBack or false,
	RequireTouch = _G.RequireTouch or true
}

if _G.scriptrunmm2autovoteff then
	local hintt = Instance.new("Message",workspace)
	hintt.Text = "script already running"
	game.Debris:AddItem(hintt,3)
	return
else
	_G.scriptrunmm2autovoteff = true
end

local OMGGIGOTTAVOTEBROO = false
local GeneralCooldown = false

if typeof(replicatesignal) ~= "function" then
	local hintt = Instance.new("Message",workspace)
	hintt.Text = "bro "..string.lower(tostring(identifyexecutor())).." doesn't support replicatesignal get a better executor"
	game.Debris:AddItem(hintt,8)
	_G.scriptrunmm2autovoteff = nil
	return
end

local padfound = nil
if typeof(MapName) == "number" then
	padfound = workspace.Lobby.VotePads:WaitForChild("VotePad"..tostring(MapName))
else
	for _, d in pairs(workspace.Lobby.VotePads:GetChildren()) do
		if d.VoteInfoGui.Container.MapName.Text == MapName then
			padfound = d
		end
	end
end

local function doMapThing(usepad)
	if OMGGIGOTTAVOTEBROO then return end
	OMGGIGOTTAVOTEBROO = true
	
	local NeededVotes = tonumber((usepad.VoteInfoGui.Container.Votes.Text:gsub("Votes: ",""))) + VoteTimes
	local oldpos = game.Players.LocalPlayer.Character:GetPivot()
	
	while task.wait() do
		if usepad.VoteInfoGui.Enabled == false then
			break
		end
		if tonumber((usepad.VoteInfoGui.Container.Votes.Text:gsub("Votes: ",""))) >= NeededVotes then
			break
		end
		local CurrCHar = game.Players.LocalPlayer.Character
		replicatesignal(game.Players.LocalPlayer.Kill)
		repeat task.wait() until game.Players.LocalPlayer.Character ~= CurrCHar and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
		local CurrentVotes = tonumber((usepad.VoteInfoGui.Container.Votes.Text:gsub("Votes: ","")))
		local VotesHas = tonumber((usepad.VoteInfoGui.Container.Votes.Text:gsub("Votes: ","")))
		repeat
			CurrentVotes = tonumber((usepad.VoteInfoGui.Container.Votes.Text:gsub("Votes: ","")))
			game.Players.LocalPlayer.Character:PivotTo(usepad.Pad.CFrame)
			task.wait()
		until CurrentVotes > VotesHas or usepad.VoteInfoGui.Enabled == false
	end
	
	repeat task.wait() until game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
	if Settings.ReturnBackToOldPos then
		game.Players.LocalPlayer.Character:PivotTo(oldpos)
	end
	OMGGIGOTTAVOTEBROO = false
end

if Settings.RequireTouch then
	for _, d in pairs(workspace.Lobby.VotePads:GetChildren()) do
		d:WaitForChild("Pad").Touched:Connect(function(h)
			if GeneralCooldown then return end
			if d.VoteInfoGui.Enabled == false then return end
			GeneralCooldown = true
			task.delay(5,function()
				GeneralCooldown = false
			end)
			if h.Parent:FindFirstChild("Humanoid") and h.Parent:FindFirstChild("HumanoidRootPart") and h.Parent.Humanoid.Health > 0 and h.Parent == game.Players.LocalPlayer.Character then
				doMapThing(d)
			end
		end)
	end
	return
end

doMapThing(padfound)

_G.scriptrunmm2autovoteff = nil
