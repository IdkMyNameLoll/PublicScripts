local function cloneModelToSupportCrux(part)
	local model = getModelFromPart(part)

	local clone = model:Clone()
	clone.Name = "Fake"..tostring(model.Name)
	clone:SetAttribute("Crucifixing",true)

	local parts = {}
	for _, descendant in pairs(clone:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end

	local center = clone:GetPivot()

	local primary = Instance.new("Part")
	primary.Name = "SealPrimaryPart"
	primary.Size = Vector3.new(1, 1, 1)
	primary.CFrame = center
	primary.Anchored = true
	primary.CanCollide = false
	primary.CanQuery = false
	primary.CanTouch = false
	primary.Transparency = 1
	primary.Parent = clone

	clone.PrimaryPart = primary

	for _, p in pairs(parts) do
		if p ~= primary then
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = p
			weld.Parent = primary
		end
	end
	
	return clone
end

