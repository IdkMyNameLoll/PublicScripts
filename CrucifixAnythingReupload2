local function getModelFromPart(part)
	local current = part

	while current and current ~= game do
		if current:IsA("Model") then
			return current
		end
		current = current.Parent
		task.wait()
	end

	return nil
end

local function copyHumanoidAnimationsV2(fromHumanoid,toHumanoid)
	local fromAnimator = fromHumanoid:FindFirstChildOfClass("Animator")
	local toAnimator = toHumanoid:FindFirstChildOfClass("Animator")

	if not fromAnimator or not toAnimator then
		return
	end

	for _, track in ipairs(fromAnimator:GetPlayingAnimationTracks()) do
		local animation = track.Animation
		if animation then
			local newTrack = toAnimator:LoadAnimation(animation)
			newTrack.Looped = track.Looped
			newTrack:Play()
			newTrack.TimePosition = track.TimePosition
			newTrack:AdjustSpeed(track.Speed)
		end
	end
end

