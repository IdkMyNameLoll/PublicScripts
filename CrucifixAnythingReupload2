local function PlaceCrucifixSigil(sigilModel, fromCFrame, collisionModel)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {collisionModel}
	params.IgnoreWater = true

	local rayOrigin = fromCFrame.Position
	local rayDirection = Vector3.new(0, -50, 0)
	local hit = workspace:Raycast(rayOrigin, rayDirection, params)

	sigilModel.Parent = workspace
	
	if hit then
		sigilModel:PivotTo(CFrame.new(hit.Position + Vector3.new(0,0.1,0)))
	else
		sigilModel:PivotTo(CFrame.new(fromCFrame.Position - Vector3.new(0,3,0)))
	end
end

